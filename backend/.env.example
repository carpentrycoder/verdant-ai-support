APP_NAME=Verdant AI Support API
APP_ENV=development
DEBUG=false

DB_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

JWT_SECRET_KEY=replace-with-secure-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

WEBHOOK_SECRET=replace-with-secure-random-value

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=300

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000